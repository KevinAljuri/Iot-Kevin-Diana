      "pluginVersion": "12.2.0",
      "targets": [
        {
          "query": "import \"timezone\"\r\noption location = timezone.location(name: \"America/Bogota\")\r\n\r\nbase = from(bucket: \"aulas\")\r\n  |> range(start: -7d)\r\n  |> filter(fn: (r) => r._measurement == \"lecturas\" and r.variable == \"temperatura\" and r._field == \"valor\")\r\n  |> filter(fn: (r) => r._value > 5.0)\r\n  |> group(columns: [\"aula\"])\r\n\r\npromedio = base\r\n  |> aggregateWindow(every: 1d, fn: mean, createEmpty: false)\r\n  |> set(key: \"estadistica\", value: \"Promedio\")\r\n\r\nminimo = base\r\n  |> aggregateWindow(every: 1d, fn: min, createEmpty: false)\r\n  |> set(key: \"estadistica\", value: \"Minimo\")\r\n\r\nmaximo = base\r\n  |> aggregateWindow(every: 1d, fn: max, createEmpty: false)\r\n  |> set(key: \"estadistica\", value: \"Maximo\")\r\n\r\nunion(tables: [promedio, minimo, maximo])\r\n  |> group(columns: [\"aula\"])\r\n  |> pivot(rowKey: [\"_time\", \"aula\"], columnKey: [\"estadistica\"], valueColumn: \"_value\")\r\n  |> keep(columns: [\"_time\", \"aula\", \"Promedio\", \"Minimo\", \"Maximo\"])\r\n  |> sort(columns: [\"_time\"], desc: true)\r\n",
          "refId": "A"
        }
      ],
      "title": "Estadísticas diarias de temperatura",
      "type": "table"
    },
